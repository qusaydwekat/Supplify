<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>coverage,cobertura,html</Format>
          <Exclude>[**/tests/**]*,[**/*.d.ts]*</Exclude>
          <IncludeDirectory>../supplify/src</IncludeDirectory>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
